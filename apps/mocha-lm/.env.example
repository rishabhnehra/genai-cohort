# --- App ---
APP_URL=http://localhost:3002

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/notebooks

# --- Database (Postgres via docker-compose) ---
# Prefer 127.0.0.1 over localhost on Windows — Node/Prisma often resolve
# localhost to ::1 first, which Docker Desktop may not accept for published ports.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/mocha_lm

# --- Redis (BullMQ queues, via docker-compose) ---
REDIS_URL=redis://127.0.0.1:6380

# --- Qdrant (vector store, via docker-compose) ---
QDRANT_URL=http://127.0.0.1:6335
QDRANT_COLLECTION=mocha_lm_chunks

# --- OpenRouter / LLM ---
OPENROUTER_API_KEY=
CHAT_MODEL=openai/gpt-4o-mini
STEP_BACK_MODEL=openai/gpt-4o-mini
REFINE_QUERY_MODEL=openai/gpt-4o-mini
SUB_QUERIES_MODEL=openai/gpt-4o-mini
RERANK_MODEL=openai/gpt-4o-mini

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Ingestion worker ---
INGESTION_WORKER_CONCURRENCY=2
MAX_UPLOAD_BYTES=26214400
MAX_SOURCES_PER_NOTEBOOK=50

# --- Retrieval ---
RETRIEVAL_TOP_K=8
